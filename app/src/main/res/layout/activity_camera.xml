<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Plugin Overlay Container (for grid, crop, barcode overlays) -->
    <FrameLayout
        android:id="@+id/pluginOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Controls (Samsung/Google Style) -->
    <!-- Top Bar: Minimalist 2-button design (Flash + Settings only) -->
    <!-- Uses RelativeLayout for proper left/right positioning -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="24dp">

        <!-- Flash Button (left side) -->
        <ImageButton
            android:id="@+id/flashButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentStart="true"
            android:background="@drawable/enhanced_button_background"
            android:src="@drawable/ic_flash_off"
            android:scaleType="centerInside"
            android:padding="16dp"
            android:contentDescription="@string/toggle_flash"
            android:importantForAccessibility="yes"
            android:stateListAnimator="@animator/button_press_scale" />

        <!-- Settings Button (right side) -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/camera_control_background"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:padding="16dp"
            android:contentDescription="@string/camera_settings" />

    </RelativeLayout>

    <!-- Hidden buttons for code compatibility (visibility=gone) -->
    <!-- These buttons still exist in code but are hidden from UI -->
    <!-- Night Mode: Accessible via plugin menu -->
    <!-- Video Record: TODO - Add mode selector (Photo/Video modes) -->
    <ImageButton
        android:id="@+id/nightModeButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="Night Mode (Hidden - use plugin menu)" />

    <ImageButton
        android:id="@+id/videoRecordButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="Record Video (Hidden - TODO: mode selector)" />

    <!-- PiP Button (Left side, below flash button) -->
    <ImageButton
        android:id="@+id/pipButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/enhanced_button_background"
        android:src="@drawable/ic_pip"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:alpha="1.0"
        android:contentDescription="Toggle Dual Camera PiP Mode"
        android:elevation="4dp"
        android:stateListAnimator="@animator/button_press_scale" />

    <!-- Scan Barcode Action Button (Left side, below PiP button) -->
    <ImageButton
        android:id="@+id/scanBarcodeButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:layout_marginTop="164dp"
        android:background="@drawable/enhanced_button_background"
        android:src="@drawable/ic_barcode"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:alpha="1.0"
        android:contentDescription="Scan Barcode"
        android:elevation="4dp"
        android:stateListAnimator="@animator/button_press_scale" />

    <!-- Scan QR Code Action Button (Left side, below Barcode button) -->
    <ImageButton
        android:id="@+id/scanQrButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:layout_marginTop="228dp"
        android:background="@drawable/enhanced_button_background"
        android:src="@drawable/ic_focus"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:alpha="1.0"
        android:contentDescription="Scan QR Code"
        android:elevation="4dp"
        android:stateListAnimator="@animator/button_press_scale" />

    <!-- Master Plugin Button (right side) -->
    <ImageButton
        android:id="@+id/masterPluginButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:background="@drawable/enhanced_button_background"
        android:src="@drawable/ic_extension"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:alpha="1.0"
        android:contentDescription="Plugins Menu"
        android:elevation="4dp"
        android:stateListAnimator="@animator/button_press_scale" />

    <!-- Plugin Dropdown View (positioned below master button with max height) -->
    <com.customcamera.app.ui.PluginDropdownView
        android:id="@+id/pluginDropdownView"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="200dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="100dp"
        android:elevation="8dp" />

    <!-- Mode Selector Strip (Photo/Video/Night) -->
    <!-- Positioned above bottom controls for easy thumb access -->
    <LinearLayout
        android:id="@+id/modeSelectorStrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="164dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="@drawable/enhanced_button_background"
        android:elevation="2dp">

        <!-- Photo Mode Button -->
        <TextView
            android:id="@+id/photoModeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHOTO"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:background="@drawable/camera_control_background"
            android:alpha="1.0"
            android:clickable="true"
            android:focusable="true" />

        <!-- Video Mode Button -->
        <TextView
            android:id="@+id/videoModeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:layout_marginStart="4dp"
            android:alpha="0.5"
            android:clickable="true"
            android:focusable="true" />

        <!-- Night Mode Button -->
        <TextView
            android:id="@+id/nightModeSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NIGHT"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:layout_marginStart="4dp"
            android:alpha="0.5"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Bottom Controls (SOTA Modern Design) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="48dp"
        android:layout_marginHorizontal="32dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Gallery Button -->
        <ImageButton
            android:id="@+id/galleryButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/camera_control_background"
            android:src="@drawable/ic_gallery"
            android:scaleType="centerInside"
            android:padding="18dp"
            android:contentDescription="@string/open_gallery" />

        <!-- Main Capture Button (Large, Center) -->
        <ImageButton
            android:id="@+id/captureButton"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginHorizontal="40dp"
            android:background="@drawable/enhanced_capture_button"
            android:src="@drawable/ic_camera"
            android:scaleType="centerInside"
            android:contentDescription="@string/capture_photo"
            android:elevation="8dp"
            android:stateListAnimator="@animator/capture_button_press" />

        <!-- Switch Camera Button -->
        <ImageButton
            android:id="@+id/switchCameraButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/camera_control_background"
            android:src="@drawable/ic_switch_camera"
            android:scaleType="centerInside"
            android:padding="18dp"
            android:contentDescription="@string/switch_camera" />

    </LinearLayout>

    <!-- Gesture Hints Overlay -->
    <com.customcamera.app.presentation.GestureHintsOverlay
        android:id="@+id/gestureHintsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Performance Monitor Overlay -->
    <com.customcamera.app.presentation.PerformanceMonitor
        android:id="@+id/performanceMonitor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Diagnostic Overlay (toggle via plugin dropdown) -->
    <com.customcamera.app.debug.DiagnosticOverlay
        android:id="@+id/diagnosticOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>