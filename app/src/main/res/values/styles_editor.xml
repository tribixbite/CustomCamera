<?xml version="1.0" encoding="utf-8"?>
<!-- Photo editor styles. Kept apart from themes.xml so the editor can evolve independently. -->
<resources>
    <!-- Aspect preset chip: same colours as the viewfinder's pro chips, full 48dp touch target. -->
    <style name="Widget.CustomCamera.EditorChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/pro_chip_bg</item>
        <item name="android:textColor">@color/pro_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinTouchTargetSize">48dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Labelled tool button (Rotate / Flip / Reset): icon above text, 48dp minimum. -->
    <style name="Widget.CustomCamera.EditorAction" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">4dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:minWidth">@dimen/icon_button</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
